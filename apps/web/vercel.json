{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" != \"production\" ]; then exit 0; fi; git diff --quiet HEAD^ HEAD -- . ../../packages ../../package.json ../../package-lock.json ../../supabase/functions/mcp-server/search-translate.ts",
  "functions": {
    "app/api/automations/preview/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/imap/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/app-password/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/fastmail-app-password/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/[id]/check/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/[id]/connection/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/[id]/folders/route.ts": { "regions": ["iad1"] },
    "app/api/inboxes/[id]/route.ts": { "regions": ["iad1"] },
    "app/auth/gmail/callback/route.ts": { "regions": ["iad1"] },
    "app/auth/outlook/callback/route.ts": { "regions": ["iad1"] },
    "app/auth/outlook/admin-consent/route.ts": { "regions": ["iad1"] },
    "app/.well-known/**": { "regions": ["iad1"] },
    "app/api/**": { "regions": ["arn1"] },
    "app/admin/**": { "regions": ["arn1"] },
    "app/auth/**": { "regions": ["arn1"] },
    "app/dashboard/**": { "regions": ["arn1"] },
    "app/authorize/**": { "regions": ["arn1"] },
    "app/approvals/**": { "regions": ["arn1"] },
    "app/invite/**": { "regions": ["arn1"] },
    "app/signup/**": { "regions": ["arn1"] },
    "app/(auth)/**": { "regions": ["arn1"] },
    "app/**": { "regions": ["iad1"] }
  },
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "https://swvaxorwumispmjaaszb.supabase.co/functions/v1/mcp-server/web?forceFunctionRegion=us-east-1"
    }
  ],
  "headers": [
    {
      "source": "/api/mcp",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
