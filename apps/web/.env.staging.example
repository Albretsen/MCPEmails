# apps/web on STAGING (staging.mcpemails.com).
#
# Names only. Real values live in the Vercel project mcp-emails-web-staging and,
# for `npm run dev:staging`, in apps/web/.env.staging.local (gitignored). Never
# copy a production secret here: ENCRYPTION_KEY, DISPATCH_SECRET, CSRF_SECRET
# and KIOSK_TOKEN copied from production would make staging tokens and
# ciphertexts valid in production. Generate each one fresh.
#
# Legend in the comments:
#   S      own staging value
#   same   may reuse the production value
#   unset  leave out (dev:staging blanks anything this file does not set)
#   off    set to its off value
# Full inventory and reasoning: the staging plan, section 2.1.

# --- Environment switch -------------------------------------------------------
# `staging` turns on: robots Disallow /, X-Robots-Tag noindex, the STAGING
# ribbon, no Vercel Analytics or track(), sign-in only for
# EMAIL_RECIPIENT_ALLOWLIST, and the Resend recipient filter.
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging

# --- Core ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://staging.mcpemails.com   # S
NEXT_PUBLIC_SUPABASE_URL=                           # S: the staging project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                      # S
SUPABASE_SERVICE_ROLE_KEY=                          # S
SUPABASE_PROJECT_REF=                               # S
# SUPABASE_MANAGEMENT_API_TOKEN                     # unset (SSO admin)
ENCRYPTION_KEY=                                     # S, MUST differ from prod (openssl rand -hex 32)
CSRF_SECRET=                                        # S (openssl rand -hex 32)
REFERRAL_IP_SALT=                                   # S
DISPATCH_SECRET=                                    # S, MUST differ from prod
QUEUEY_SIGNING_SECRET=                              # S
KIOSK_TOKEN=                                        # S
# GOOGLE_SITE_VERIFICATION                          # unset

# /api/mcp is an external rewrite to this URL (next.config.js). Keep the
# region pin. S: https://<staging-ref>.supabase.co/functions/v1/mcp-server/web?forceFunctionRegion=us-east-1
MCP_EDGE_URL=

# --- Stripe (sandbox) -----------------------------------------------------------
STRIPE_SECRET_KEY=                                  # S: sandbox sk_test_
STRIPE_WEBHOOK_SECRET=                              # S
STRIPE_WEBHOOK_TOLERANCE_SECONDS=                   # same
STRIPE_PORTAL_CONFIGURATION_ID=                     # S
STRIPE_PMC_ID=                                      # S or unset
STRIPE_PRICE_PERSONAL_MONTHLY=                      # S (all prices: from scripts/stripe-staging-setup.mjs)
STRIPE_PRICE_PERSONAL_YEARLY=
STRIPE_PRICE_PERSONAL_MONTHLY_V2=
STRIPE_PRICE_PERSONAL_YEARLY_V2=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_SOLO_MONTHLY_V2=
STRIPE_PRICE_SOLO_YEARLY_V2=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BUSINESS_MAILBOX_MONTHLY=
STRIPE_PRICE_BUSINESS_MAILBOX_YEARLY=
STRIPE_PRICE_BUSINESS_FOUNDER_MONTHLY=
STRIPE_PRICE_BUSINESS_FOUNDER_YEARLY=
STRIPE_PRICE_PERSONAL_PASS_3M=
# STRIPE_PRICE_JAPAN_ROUTE_YEARLY                   # optional
STRIPE_PRICE_TWINS=                                 # S (JSON map)
# Switches: match whatever you are testing.
STRIPE_EUR_PRICES=
STRIPE_AUTOMATIC_TAX=
STRIPE_ADAPTIVE_PRICING=
STRIPE_FORCE_USD=

# --- Billing flags --------------------------------------------------------------
BILLING_LIFECYCLE_EMAILS=on                         # safe: Resend only mails the allowlist here
BILLING_PAUSE_ENABLED=on
BILLING_DOWNGRADE_ENABLED=on
BILLING_PARK_ON_CANCEL_ENABLED=on
PERSONAL_PASS_ENABLED=on
SEASONAL_OFFER_PREVIEW_NOW=                         # as needed
COMPANY_VALUATION_ARR_MULTIPLE=                     # same

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=                                     # S: key restricted to the staging sending domain
RESEND_WEBHOOK_SECRET=                              # S
RESEND_FROM_EMAIL=                                  # S: ...@staging.mcpemails.com
LIFECYCLE_EMAIL_FROM=                               # S
BILLING_EMAIL_FROM=                                 # S
PURCHASE_EMAIL_FROM=                                # S
WEBHOOK_EMAIL_FROM=                                 # S
CANCEL_REPLY_TO=                                    # S
ABANDONED_CHECKOUT_EMAIL=on
# MAIL_RELAY_URL                                    # unset: the relay is shared with production
# Exact addresses and @domain entries, comma separated. Outside production
# every Resend recipient not on this list is dropped, and on staging only
# these addresses may sign in or sign up. Empty = nobody.
EMAIL_RECIPIENT_ALLOWLIST=
SUPPORT_INBOX=                                      # S: a test mailbox, never support@mcpemails.com
SUPPORT_FROM=                                       # S: e.g. MCPEmails Support (staging) <support@staging.mcpemails.com>

# --- Email programs (start as dry runs) -----------------------------------------
ACTIVATION_HELP_ENABLED=on
ACTIVATION_HELP_DRY_RUN=true
FIRST30_ENABLED=on
FIRST30_DRY_RUN=true
FIRST30_DRAFT_MAILBOX=                              # S: a test mailbox, never the founder's
PAYWALL_FOLLOWUP_ENABLED=on
PAYWALL_FOLLOWUP_DRY_RUN=true

# --- OAuth --------------------------------------------------------------------
GMAIL_CLIENT_ID=                                    # S: the staging GCP project
GMAIL_CLIENT_SECRET=                                # S
OUTLOOK_CLIENT_ID=                                  # same app, staging redirect URI added
OUTLOOK_CLIENT_SECRET=                              # same
OUTLOOK_TENANT_ID=                                  # same

# --- Auth UI flags --------------------------------------------------------------
NEXT_PUBLIC_OAUTH_VERIFICATION_PENDING=             # as prod
NEXT_PUBLIC_SSO_ENABLED=                            # off
NEXT_PUBLIC_MICROSOFT_SIGN_IN_ENABLED=              # off at first

# --- Admin --------------------------------------------------------------------
ADMIN_EMAILS=                                       # S: the owner's test addresses
GROWTH_INTERNAL_EMAILS=                             # S
# ALBRETSEN_FEED_KEY                                # unset: it posts stats to a public site
MCPEMAILS_KEY=                                      # S or unset
CONNECT_RELEASE_ALL=                                # as prod
