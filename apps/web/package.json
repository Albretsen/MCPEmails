    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@vercel/analytics": "^2.0.1",
    "dompurify": "^3.4.7",
    "he": "^1.2.0",
    "isomorphic-dompurify": "^2.15.0",
    "jsdom": "^26.0.0",
    "mailparser": "^3.7.0",
    "mime-types": "^2.1.35",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
