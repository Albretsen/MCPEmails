# Web client (app.mcpemails.com). Copy to .env.local for local development.
# Nothing here is a secret: the anon key is a public, row-level-security key.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (publishable) key of that project.
VITE_SUPABASE_ANON_KEY=

# Base URL of the client-api edge function. Optional: defaults to
# ${VITE_SUPABASE_URL}/functions/v1/client-api
VITE_API_BASE=

# Web Push application server key (the PUBLIC half), as printed by
#   deno run scripts/generate-vapid-keys.ts
# Must equal the VAPID_PUBLIC_KEY secret of the client-api edge function.
# Empty = notifications are shown as unavailable. Push also needs the service
# worker, which only production builds register.
VITE_VAPID_PUBLIC_KEY=

# 1 = run on the in-memory mock mailbox (no sign-in, no network).
# In dev the mock is also used when the two Supabase values above are empty,
# or when the URL carries ?mock.
VITE_USE_MOCK=
