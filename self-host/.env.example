# ============================================================
# MCP Emails self-host, environment
# ============================================================
# Do NOT fill this in by hand. Run `make setup` to generate a real .env with
# cryptographically random secrets and correctly-signed PostgREST tokens.
# This file documents what each variable is for.
# ============================================================

# Postgres superuser password (internal network only).
POSTGRES_PASSWORD=

# Login password for the PostgREST `authenticator` role.
AUTHENTICATOR_PASSWORD=

# HS256 secret PostgREST uses to verify JWTs. SERVICE_ROLE_JWT / ANON_JWT below
# are signed with this exact secret, they must be regenerated together.
JWT_SECRET=

# The service_role JWT the MCP server presents to PostgREST (bypasses RLS).
SERVICE_ROLE_JWT=

# An anon JWT (unused by the server; provided for completeness).
ANON_JWT=

# AES-256-GCM key (64 hex chars) for credentials at rest. Changing this after
# you have connected an inbox makes the stored password undecryptable.
ENCRYPTION_KEY=

# Shared secret guarding the POST /dispatch scheduled-send flush.
DISPATCH_SECRET=

# Public base URL of this server. Only used to build reconnect links in error
# messages; safe to leave as the localhost default. If using the optional TLS
# proxy, set this to https://<your DNS name>.
APP_URL=http://localhost:8787

# Host port the MCP server is published on. It binds to 127.0.0.1 only; it is
# deliberately not reachable from the LAN or internet.
MCP_PORT=8787

# Optional: route SMTP submission for specific mail hosts through an HTTP
# CONNECT proxy, for hosts that refuse submission from cloud addresses
# (smtp.domeneshop.no answers "550 [ACR04] Amazon AWS IP ..."). A self-hosted
# deployment sending from its own address usually needs neither. TLS stays end
# to end, and an unreachable relay falls back to a direct dial on its own.
# Setup and hardening: docs/smtp-relay.md
# SMTP_RELAY_URL=http://user:password@relay.example.net:3128
# SMTP_RELAY_HOSTS=domeneshop.no
