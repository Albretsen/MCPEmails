# Copy to .env. Never commit .env. Never put a password here that is not for a
# throwaway mailbox.

# --- Where the capture runs -------------------------------------------------
# A Vercel preview or production URL, or http://localhost:3000 if local sign in
# actually works for you. No trailing slash.
DEMO_BASE_URL=https://mcpemails.com

# --- The demo account -------------------------------------------------------
# reset.mjs refuses to run unless the signed in session matches BOTH of these.
DEMO_ACCOUNT_EMAIL=demo@mcpemails.com
DEMO_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Addresses reset.mjs is allowed to disconnect, comma separated. Anything in the
# workspace that is not on this list makes reset refuse. Keep it to .example
# domains and the known throwaway demo mailbox.
DEMO_SAFE_INBOX_DOMAINS=example,demo.mcpemails.com

# --- The throwaway mailbox filmed in the capture ----------------------------
DEMO_IMAP_HOST=imap.migadu.com
DEMO_IMAP_USER=demo@mcpemails.com
DEMO_IMAP_PASS=
DEMO_SMTP_HOST=smtp.migadu.com

# --- transcript.mjs ---------------------------------------------------------
# A scoped key from the dashboard. Read scopes are enough for the default
# transcript; a transcript with a write turn needs the matching write scope.
MCP_ENDPOINT=https://mcpemails.com/api/mcp
MCP_API_KEY=
