# ============================================================
# MCPEmails — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# Reference: Documents/Architecture/deployment-architecture.md §3
# ============================================================

# ------------------------------------------------------------
# Supabase — required for all environments
# ------------------------------------------------------------

# Your Supabase project URL (safe to expose to the browser).
# Found in: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous / public key (safe to expose to the browser).
# RLS policies enforce access control, so this key is safe to bundle.
# Found in: Supabase dashboard → Project Settings → API → Project API Keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service-role key — KEEP SECRET, server-side only.
# Bypasses Row-Level Security. Used only in Edge Functions for admin operations.
# NEVER expose this to the browser or include it in client bundles.
# Found in: Supabase dashboard → Project Settings → API → Project API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# App URL — required for auth redirect URLs
# ------------------------------------------------------------

# The canonical base URL of the app. Used by Supabase Auth to construct
# magic-link callback URLs and by OAuth providers for redirect URIs.
# Local dev: http://localhost:3000
# Production: https://mcpemails.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Search Console HTML-tag verification token. Set this only
# for the production deployment after creating the mcpemails.com property in
# Search Console. It is public and intentionally does not use NEXT_PUBLIC_.
# GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# Comma-separated operator emails allowed to view /admin/growth. This route
# uses the service-role key after validating the signed-in user against this
# list, so leave it unset in environments where the internal dashboard is off.
# ADMIN_EMAILS=you@example.com

# ------------------------------------------------------------
# Encryption — required for storing OAuth tokens at rest
# ------------------------------------------------------------

# 32-byte (256-bit) hex-encoded AES-256-GCM encryption key.
# Used to encrypt OAuth access/refresh tokens stored in the inboxes table.
# Must be identical across all instances (Next.js server + Edge Functions).
# Generate with: openssl rand -hex 32
# IMPORTANT: Must be cryptographically random. All-zeros, all-same, or sequential
# bytes are rejected at startup. Never reuse this key for any other purpose.
# KEEP SECRET — server-side only; never expose to the browser.
ENCRYPTION_KEY=replace_with_64_hex_chars_output_of_openssl_rand_hex_32

# 32-byte (256-bit) hex-encoded HMAC key used exclusively for CSRF token signing.
# Must be different from ENCRYPTION_KEY — separate keys for separate purposes.
# Generate with: openssl rand -hex 32
# KEEP SECRET — server-side only; never expose to the browser.
CSRF_SECRET=replace_with_64_hex_chars_output_of_openssl_rand_hex_32

# ------------------------------------------------------------
# Gmail OAuth — required when Gmail integration is enabled (Section 4)
# ------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Required scopes: gmail.readonly, gmail.send, gmail.modify
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/auth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ------------------------------------------------------------
# Outlook / Microsoft OAuth — required when Outlook integration is enabled (Section 5)
# ------------------------------------------------------------

# Azure Active Directory → App registrations → your app → Overview & Certificates
# Required scopes: Mail.Read, Mail.Send, Mail.ReadWrite, offline_access
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/auth/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Use "common" to support both personal and work accounts,
# or set a specific tenant GUID to restrict to one Azure AD tenant.
OUTLOOK_TENANT_ID=common

# ------------------------------------------------------------
# OAuth verification status (Gmail + Outlook connect warning)
# ------------------------------------------------------------

# While the Google OAuth app is still in Google's verification / CASA security
# assessment and Microsoft publisher verification is pending, the Gmail and
# Outlook connect flows show an in-product warning (unverified-app screen, how
# to proceed, and ~7-day token re-authorization). Treated as enabled (true) when
# unset. Set to false after Google verification + Microsoft publisher
# verification complete to hide the warning — no code change required.
NEXT_PUBLIC_OAUTH_VERIFICATION_PENDING=true

# ------------------------------------------------------------
# Fastmail — connected via app password (IMAP/SMTP), no OAuth credentials needed.
# Fastmail OAuth is partner-gated (manual client registration) and not used here.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Stripe — required when billing is integrated (Section 20)
# ------------------------------------------------------------

# Stripe dashboard → Developers → API keys
# Use sk_test_* in Development and Preview; sk_live_* in Production only.
STRIPE_SECRET_KEY=sk_test_...

# Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe publishable key (safe to expose to the browser).
# Use pk_test_* in Development and Preview; pk_live_* in Production only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs for each paid plan and billing interval.
# Create them with `node scripts/stripe-setup.js`, or by hand in the Stripe
# dashboard, then paste the resulting price_... IDs here.
# Use price_... from the test-mode dashboard for Development/Preview.
# Use price_... from the live-mode dashboard for Production.
#
# The variable names lag the customer-facing names by one rename and are kept
# as they are so no environment has to be re-keyed:
#   STRIPE_PRICE_SOLO_*  is the plan sold as "Pro"  ($29/mo, $276/yr)
#   STRIPE_PRICE_PRO_*   is the plan sold as "Team" ($79/mo, $756/yr)
# The internal plan ids in the database are `solo` and `pro` to match.
# There is no Enterprise tier; the STRIPE_PRICE_ENTERPRISE_* variables that
# used to be listed here were never read by any code.
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_SOLO_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ------------------------------------------------------------
# MCP edge function: fair-use action ceiling
# ------------------------------------------------------------

# Kill switch for the per-billing-period action ceiling enforced by the
# mcp-server edge function. Enforcement is ON by default and covers every
# workspace; set this to the literal string "true" ONLY to disable it in an
# emergency (a ceiling set too low, a metering bug). Any other value, or the
# variable being absent, means enforcement is on.
#
# This is a SUPABASE EDGE FUNCTION secret, not a Vercel variable. Set it with:
#   npx supabase secrets set USAGE_ENFORCEMENT_DISABLED=true --project-ref <ref>
#
# The ceiling is an abuse backstop, never a pricing lever: the plans sell
# connected inboxes, and no plan sells a larger action allowance.
# USAGE_ENFORCEMENT_DISABLED=true
