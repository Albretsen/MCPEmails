{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mcpemails/emails",
  "title": "MCP Emails",
  "description": "Never-stored live email: read, send, organize, schedule and auto-triage Gmail or any IMAP mailbox.",
  "version": "1.0.5",
  "websiteUrl": "https://mcpemails.com",
  "icons": [
    {
      "src": "https://mcpemails.com/connector-icon-light.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"],
      "theme": "light"
    },
    {
      "src": "https://mcpemails.com/connector-icon-dark.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"],
      "theme": "dark"
    }
  ],
  "repository": {
    "url": "https://github.com/Albretsen/MCPEmails",
    "source": "github",
    "id": "1248205223"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcpemails.com/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcpemails",
      "version": "1.0.5",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MCPEMAILS_API_KEY",
          "description": "MCP Emails API key: 'mcpe_' followed by 64 hex characters. Create one at https://mcpemails.com/dashboard/keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
